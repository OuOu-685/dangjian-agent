      "code": "def classify_major(m):\n    \"\"\"按专业名归类：cs=计算机 / arts=文科 / sci=理工 / art=艺术 / other=其它\"\"\"\n    m = (m or '').lower()\n    cs = ['计算机', '软件', '信息', '人工智能', '数据', '网络', '物联网', '通信']\n    arts = ['文学', '历史', '哲学', '教育', '法学', '管理', '新闻', '外语', '经济', '会计']\n    sci = ['机械', '电子', '自动化', '材料', '化工', '土木', '物理', '数学', '建筑', '能源']\n    art = ['设计', '美术', '音乐', '传媒', '艺术', '表演']\n    for k in cs:\n        if k in m:\n            return 'cs'\n    for k in arts:\n        if k in m:\n            return 'arts'\n    for k in sci:\n        if k in m:\n            return 'sci'\n    for k in art:\n        if k in m:\n            return 'art'\n    return 'other'\n\n\nasync def main(args: Args) -> Output:\n    p = args.params\n    q = p.get('q_profile') or []\n    registered = len(q) > 0\n    prof = q[0] if registered and isinstance(q[0], dict) else {}\n\n    major = prof.get('major', '') or ''\n    major_type = classify_major(major)\n\n    if not registered:\n        status = 'not_registered'\n        tip = '我还没你的档案，先告诉我学校、专业、学历层次和当前阶段，我才能给你专业指导。'\n    else:\n        status = 'checked'\n        tip = ''\n\n    ret: Output = {\n        \"v_ok\": 'Y' if registered else 'N',\n        \"v_status\": status,\n        \"v_major_type\": major_type,\n        \"v_major\": major,\n        \"v_school\": prof.get('school', '') or '',\n        \"v_degree\": prof.get('degree', '') or '',\n        \"tip_text\": tip,\n    }\n    return ret\n",
      "outputs": [
