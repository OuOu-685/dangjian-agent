    {
      "id": "100003",
      "type": "代码",
      "title": "前置校验",
      "inputs": {
        "in_user_id": "100001.in_user_id",
        "in_guide_type": "100001.in_guide_type",
        "q_profile": "100002.q_profile"
      },
      "code": "GUIDE_TYPES = ['选题', '技术选型', '进度', '演示', '文档']\n\n\ndef normalize_guide(raw):\n    s = str(raw).strip() if raw is not None else ''\n    if not s:\n        return ''\n    for t in GUIDE_TYPES:\n        if t in s:\n            return t\n    alias = {\n        '选什么': '选题', '做什么': '选题', '题目': '选题',\n        '技术栈': '技术选型', '框架': '技术选型',\n        '时间': '进度', '计划': '进度',\n        '讲稿': '演示', '答辩稿': '演示', '脚本': '演示',\n        '说明书': '文档', '报告': '文档',\n    }\n    for k, v in alias.items():\n        if k in s:\n            return v\n    return ''\n\n\nasync def main(args: Args) -> Output:\n    p = args.params\n    q = p.get('q_profile') or []\n    registered = len(q) > 0\n    prof = q[0] if registered and isinstance(q[0], dict) else {}\n\n    guide_type = normalize_guide(p.get('in_guide_type'))\n    if not guide_type:\n        guide_type = '选题'\n\n    if not registered:\n        status = 'not_registered'\n        tip = '我还没你的档案，先告诉我学校、专业、学历层次和当前阶段，我才能给你作品指导。'\n    else:\n        status = 'checked'\n        tip = ''\n\n    ret: Output = {\n        \"v_ok\": 'Y' if registered else 'N',\n        \"v_status\": status,\n        \"v_guide_type\": guide_type,\n        \"v_school\": prof.get('school', '') or '',\n        \"v_college\": prof.get('college', '') or '',\n        \"v_major\": prof.get('major', '') or '',\n        \"v_degree\": prof.get('degree', '') or '',\n        \"v_topic\": prof.get('topic', '') or '',\n        \"v_stage\": prof.get('current_stage', '') or '',\n        \"tip_text\": tip,\n    }\n    return ret\n",
      "outputs": [
        {
          "name": "v_ok",
          "type": "string"
        },
        {
          "name": "v_status",
          "type": "string"
        },
        {
          "name": "v_guide_type",
          "type": "string"
        },
